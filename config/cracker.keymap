#include <input/processors.dtsi>
#include <layout_shift.dtsi>
#include <layout_shift_kp_override.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1

&mt {
    flavor = "balanced";
    quick-tap-ms = <200>;
    tapping-term-ms = <400>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <200>;
    tapping-term-ms = <400>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_escape {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
            layers = <0>;
        };

        combo_paste_value {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp LS(LC(V))>;
            layers = <0>;
        };

        combo_cut {
            timeout-ms = <50>;
            key-positions = <2 3>;
            bindings = <&kp LC(X)>;
            layers = <0>;
        };

        combo_select_all {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp LC(A)>;
            layers = <0>;
        };

        combo_paste {
            timeout-ms = <50>;
            key-positions = <11 12>;
            bindings = <&kp LC(V)>;
            layers = <0>;
        };

        combo_copy {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp LC(C)>;
            layers = <0>;
        };

        combo_copy_right {
            timeout-ms = <50>;
            key-positions = <13 14>;
            bindings = <&kp LC(R)>;
            layers = <0>;
        };

        combo_copy_down {
            timeout-ms = <50>;
            key-positions = <22 23>;
            bindings = <&kp LC(D)>;
            layers = <0>;
        };

        combo_home {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&kp LC(HOME)>;
            layers = <0>;
        };

        combo_find {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp LC(F)>;
            layers = <0>;
        };

        combo_replace {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp LC(H)>;
            layers = <0>;
        };

        combo_list {
            timeout-ms = <50>;
            key-positions = <17 18>;
            bindings = <&kp LS(LC(L))>;
            layers = <0>;
        };

        combo_date {
            timeout-ms = <50>;
            key-positions = <18 19>;
            bindings = <&kp LC(SEMICOLON)>;
            layers = <0>;
        };

        combo_center_dot {
            timeout-ms = <50>;
            key-positions = <28 29>;
            bindings = <&kp SLASH>;
            layers = <0>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        screen_shot_macro: screen_shot_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp RSHIFT>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LEFT_GUI &kp RSHIFT>;

            label = "SCREENSHOT";
        };

        parenthesis_macro: parenthesis_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT>;
            label = "PARENTHESIS_MACRO";
        };

        bracket_macro: bracket_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;
            label = "BRACKET_MACRO";
        };

        zoom_in_macro: zoom_in_macro {
            compatible = "zmk,behavior-macro";
            wait-ms = <15>;
            tap-ms = <15>;
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&msc SCRL_UP>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "ZOOM_IN_MACRO";
        };

        zoom_out_macro: zoom_out_macro {
            compatible = "zmk,behavior-macro";
            wait-ms = <15>;
            tap-ms = <15>;
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&msc SCRL_DOWN>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "ZOOM_OUT_MACRO";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        tog_off: toggle_layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        kp: key_press {
            compatible = "zmk,behavior-layout-shift-key-press";
            #binding-cells = <1>;
            label = "LAYOUT_SHIFT_KEY_PRESS";
        };

        tog_ls: toggle_layout_shift {
            compatible = "zmk,behavior-layout-shift-toggle";
            #binding-cells = <0>;
            toggle-mode = "flip";
            layout-maps = <&layout_shift_map_us_to_jis>;
            label = "LAYOUT_SHIFT_TOGGLE";
        };

        tog_ls_on: toggle_layout_shift_on {
            compatible = "zmk,behavior-layout-shift-toggle";
            #binding-cells = <0>;
            toggle-mode = "on";
            layout-maps = <&layout_shift_map_us_to_jis>;
            label = "LAYOUT_SHIFT_TOGGLE_ON";
        };

        tog_ls_off: toggle_layout_shift_off {
            compatible = "zmk,behavior-layout-shift-toggle";
            #binding-cells = <0>;
            toggle-mode = "off";
            layout-maps = <&layout_shift_map_us_to_jis>;
            label = "LAYOUT_SHIFT_TOGGLE_OFF";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q               &kp W             &kp E        &kp R      &kp T                  &kp Y        &kp U  &kp I     &kp O              &lt 1 P
&mt LEFT_CONTROL A  &mt LEFT_SHIFT S  &kp D        &kp F      &kp G                  &kp H        &kp J  &kp K     &mt RIGHT_SHIFT L  &mt RIGHT_CONTROL COMMA
&mt LEFT_GUI Z      &mt LEFT_ALT X    &kp C        &kp V      &lt 5 B                &kp N        &kp M  &mkp MB1  &mkp MB2           &lt 3 PERIOD
                                      &lt 4 SPACE  &lt 2 TAB  &kp BACKSPACE          &lt 1 ENTER
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans     &kp PLUS   &kp ASTERISK  &trans             &trans     &trans    &kp PAGE_UP    &trans    &trans
&trans  &kp EQUAL  &kp MINUS  &kp SLASH     &kp LANG2          &kp LANG1  &mkp MB4  &kp PAGE_DOWN  &mkp MB5  &trans
&trans  &trans     &trans     &trans        &kp AT             &trans     &mkp MB3  &mkp MB1       &mkp MB2  &trans
                   &trans     &trans        &trans             &trans
            >;
        };

        FUNCTION {
            bindings = <
&kp EXCLAMATION  &kp DOUBLE_QUOTES  &kp HASH      &kp DOLLAR           &kp PERCENT                  &trans              &trans         &trans     &trans     &trans
&kp AMPERSAND    &kp SINGLE_QUOTE   &kp QUESTION  &kp TILDE            &kp INTERNATIONAL_3          &bracket_macro      &kp SEMICOLON  &kp COLON  &kp CARET  &kp LS(INTERNATIONAL_3)
&kp DEL          &trans             &trans        &kp LA(PRINTSCREEN)  &screen_shot_macro           &parenthesis_macro  &trans         &trans     &trans     &trans
                                    &trans        &trans               &trans                       &trans
            >;
        };

        NUM {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5           &trans        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans
&kp F6  &kp F7  &kp F8  &kp F9  &kp F10          &kp EQUAL     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &trans
&trans  &trans  &trans  &trans  &trans           &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans
                &trans  &trans  &trans           &trans
            >;
        };

        ARROW {
            bindings = <
&trans                  &zoom_out_macro  &kp UP_ARROW            &zoom_in_macro     &trans                           &trans  &kp C_BRIGHTNESS_DEC  &kp LG(UP_ARROW)    &kp C_BRIGHTNESS_INC  &kp HOME
&kp LS(LC(LEFT_ARROW))  &kp LEFT_ARROW   &kp DOWN_ARROW          &kp RIGHT_ARROW    &kp LS(LC(RIGHT_ARROW))          &trans  &kp LG(LEFT_ARROW)    &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)   &kp END
&kp DEL                 &kp LC(PAGE_UP)  &kp LS(LC(DOWN_ARROW))  &kp LC(PAGE_DOWN)  &trans                           &trans  &trans                &trans              &trans                &trans
                                         &trans                  &trans             &trans                           &trans
            >;
        };

        BLUETOOTH {
            bindings = <
&trans  &trans  &trans  &trans      &kp C_VOLUME_UP            &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &kp C_MUTE  &kp C_VOLUME_DOWN          &tog_ls       &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans      &trans                     &bootloader   &trans        &trans        &trans        &bt BT_CLR_ALL
                &trans  &trans      &trans                     &trans
            >;
        };
    };
};
